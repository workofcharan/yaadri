# FRONTEND (Vite) environment example — safe to expose to the browser.
# Copy to .env.local for local development. Local Demo mode needs none
# of these; they are only read when running in Connected mode.

# Public Supabase project URL and anon key (NOT the service role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to allow the UI to offer Connected mode at all.
VITE_ENABLE_CONNECTED_MODE=false
