# SERVER-ONLY environment example (Supabase Edge Functions / project
# secrets). NEVER put these in a Vite VITE_ variable or client bundle.

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Optional LLM adapter — disabled unless both are set. Missing
# credentials must never break core (rule-based) functionality.
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=
AI_FEATURE_ENABLED=false

# Simple per-user / global usage caps enforced server-side (Edge Function).
AI_MAX_REQUESTS_PER_USER_PER_DAY=20
AI_MAX_REQUESTS_GLOBAL_PER_DAY=500
